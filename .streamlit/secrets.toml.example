# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste these into: App settings -> Secrets.
# NEVER commit the real secrets.toml file to git.

RESEND_API_KEY = "re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Must be a verified sender on your Resend account/domain, e.g. "Enneagram Reports <reports@yourdomain.com>"
RESEND_FROM_ADDRESS = "Enneagram Reports <onboarding@resend.dev>"

# Optional: simple shared passcode to keep the assessment link from being used by randoms.
APP_ACCESS_CODE = ""

# Free key for the practitioner-only Intervention & Session Planning Report (Report 2).
# Get one at https://console.groq.com/keys - sign up, then click "Create API Key".
# Shown only once, so copy it immediately. No credit card required for the free tier.
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: override the Groq model used. Leave blank to use the built-in default.
# Check current model IDs at https://console.groq.com/docs/models if this one is retired.
GROQ_MODEL = ""
