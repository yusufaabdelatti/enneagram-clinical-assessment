# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, paste these into: App settings -> Secrets.
# NEVER commit the real secrets.toml file to git.

RESEND_API_KEY = "re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Must be a verified sender on your Resend account/domain, e.g. "Enneagram Reports <reports@yourdomain.com>"
RESEND_FROM_ADDRESS = "Enneagram Reports <onboarding@resend.dev>"

# Optional: simple shared passcode to keep the assessment link from being used by randoms.
APP_ACCESS_CODE = ""
